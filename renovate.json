{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "semanticCommitScope": null,
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**", "**/vendor/**", "**/examples/**"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The nginx base images in the Dockerfile, as tag and multi-arch index digest. depType is the branch. Docker versioning keeps -trixie and -alpine as the compatibility suffix, so each image stays on its system. An image rebuilt under the same tag gives a digest update.",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["# renovate: branch=(?<depType>mainline|stable) nginx\\nARG [A-Z0-9_]+=nginx:(?<currentValue>\\d+\\.\\d+\\.\\d+-[a-z]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
      "depNameTemplate": "nginx",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The nginx mainline version in the README examples: images, tarball and module image. Mainline has an odd minor version.",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "nginx:(?<currentValue>\\d+\\.\\d*[13579]\\.\\d+)-",
        "nginx-(?<currentValue>\\d+\\.\\d*[13579]\\.\\d+)",
        "ngx_http_geoip2_module:(?<currentValue>\\d+\\.\\d*[13579]\\.\\d+)"
      ],
      "depNameTemplate": "nginx mainline",
      "depTypeTemplate": "mainline",
      "packageNameTemplate": "nginx",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[\\d.]+)-trixie$"
    },
    {
      "customType": "regex",
      "description": "The nginx stable version in the README examples. Stable has an even minor version.",
      "managerFilePatterns": ["/^README\\.md$/"],
      "matchStrings": [
        "nginx:(?<currentValue>\\d+\\.\\d*[02468]\\.\\d+)-",
        "nginx-(?<currentValue>\\d+\\.\\d*[02468]\\.\\d+)",
        "ngx_http_geoip2_module:(?<currentValue>\\d+\\.\\d*[02468]\\.\\d+)"
      ],
      "depNameTemplate": "nginx stable",
      "depTypeTemplate": "stable",
      "packageNameTemplate": "nginx",
      "datasourceTemplate": "docker",
      "extractVersionTemplate": "^(?<version>[\\d.]+)-trixie$"
    },
    {
      "customType": "regex",
      "description": "The commit of github.com/maxmind/MaxMind-DB the integration tests take their databases from",
      "managerFilePatterns": ["tests/integration/databases.sh"],
      "matchStrings": ["# renovate: maxmind-db\\nCOMMIT=(?<currentDigest>[0-9a-f]{40})"],
      "depNameTemplate": "MaxMind-DB test data",
      "packageNameTemplate": "https://github.com/maxmind/MaxMind-DB",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "The dockerfile manager reads FROM ${NGINX_IMAGE} through the ARG default. The regex manager above owns the nginx images, so this one stays off.",
      "matchManagers": ["dockerfile"],
      "matchDepNames": ["nginx"],
      "enabled": false
    },
    {
      "description": "Mainline stays on odd minor versions. One pull request updates both Dockerfile images, tag or digest, and the README.",
      "matchDepTypes": ["mainline"],
      "allowedVersions": "/^\\d+\\.\\d*[13579]\\.\\d+(-(trixie|alpine))?$/",
      "groupName": "nginx mainline"
    },
    {
      "description": "Stable stays on even minor versions. One pull request updates both Dockerfile images, tag or digest, and the README.",
      "matchDepTypes": ["stable"],
      "allowedVersions": "/^\\d+\\.\\d*[02468]\\.\\d+(-(trixie|alpine))?$/",
      "groupName": "nginx stable"
    },
    {
      "description": "The MaxMind test databases change rarely: check monthly. A changed database fails the checksums in databases.sh until someone checks the expected values in tests/integration/run.sh.",
      "matchDepNames": ["MaxMind-DB test data"],
      "schedule": ["* 0-6 1 * *"]
    }
  ]
}
